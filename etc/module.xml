<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="OOCS_LynxPaymentPayPal">
        <sequence>
            <!-- The pool this module registers its renderer into. -->
            <module name="OOCS_LynxCheckout"/>
            <!-- InstallReviewLayout depends on CreateDefaultDesign declared there. -->
            <module name="OOCS_LynxPageBuilder"/>
            <!-- The gateway this module puts a Lynx front on; everything server-side stays its. -->
            <module name="Magento_Paypal"/>
        </sequence>
    </module>
</config>
